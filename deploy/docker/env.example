# Скопируйте в .env рядом с docker-compose.yml и заполните (значения не коммитить).
# Пароль БД: сгенерируйте свой, например: openssl rand -base64 24
EXAMFORGE_DB_PASSWORD=CHANGE_ME_db_password
# HMAC-ключ кодов приглашений: 64 hex-символа (32 байта), например: openssl rand -hex 32
EXAMFORGE_HMAC_KEY=CHANGE_ME_64_hex_chars
