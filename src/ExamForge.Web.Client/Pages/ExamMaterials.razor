@page "/exam/materials"
@layout StudentLayout
@rendermode InteractiveWebAssembly
@inject ExamApiClient Api

<PageTitle>Лекции — Exam Forge</PageTitle>

@if (_loading)
{
    <p class="ef-card__meta" aria-live="polite">Загрузка…</p>
}
else if (_materials is null)
{
    <section class="ef-card">
        <h1 class="ef-card__title">Лекции</h1>
        <p class="ef-card__meta">Материалы доступны после входа по коду приглашения или по вашему логину.</p>
        <a class="ef-button ef-button--primary" href="exam">Войти</a>
    </section>
}
else if (_materials.Count == 0)
{
    <h1>Лекции</h1>
    <div class="ef-callout ef-callout--info"><p>Пока нет доступных материалов. Преподаватель назначит их позже.</p></div>
}
else
{
    <h1>Лекции</h1>
    @foreach (var material in _materials)
    {
        <section class="ef-card" aria-labelledby="m-@material.MaterialId">
            <p class="ef-card__eyebrow">PDF · @SizeText(material.FileSizeBytes)</p>
            <h2 id="m-@material.MaterialId" class="ef-card__title">@material.Title</h2>
            @if (!string.IsNullOrEmpty(material.Description))
            {
                <p class="ef-card__meta">@material.Description</p>
            }
            <a class="ef-button ef-button--secondary" target="_blank" rel="noopener"
               href="@($"/api/materials/{material.MaterialId}/download")">
                Открыть PDF
            </a>
        </section>
    }
}

@code {
    private bool _loading = true;
    private List<StudentMaterialDto>? _materials;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
            return;
        try
        {
            _materials = await Api.TryGetMaterialsAsync();
        }
        catch (ExamSessionExpiredException)
        {
            _materials = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string SizeText(long bytes)
        => bytes >= 1024 * 1024 ? $"{bytes / (1024 * 1024)} МиБ" : $"{bytes / 1024} КиБ";
}
