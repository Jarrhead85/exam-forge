@inherits LayoutComponentBase

<div class="ef-app">
    <aside class="ef-rail" aria-label="Разделы кабинета">
        <a class="ef-brand" href="/">
            <span class="ef-brand-mark" aria-hidden="true">EF</span>
            <span class="ef-brand-name">Exam&nbsp;Forge</span>
        </a>
        <div class="ef-rail-desktop">
            <TeacherNavigation />
        </div>
        <details class="ef-rail-mobile">
            <summary>Разделы кабинета</summary>
            <TeacherNavigation />
        </details>
    </aside>
    <main class="ef-app-main" id="main" tabindex="-1">
        @Body
    </main>
</div>

<div id="blazor-error-ui" class="ef-error-ui" data-nosnippet>
    <p>Произошла непредвиденная ошибка. Перезагрузите страницу и повторите действие.</p>
    <a href="" class="reload">Перезагрузить</a>
    <span class="dismiss" aria-hidden="true">🗙</span>
</div>
