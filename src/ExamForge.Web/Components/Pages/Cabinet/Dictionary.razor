@page "/cabinet/dictionary"
@layout Layout.TeacherLayout
@attribute [Authorize]
@* prerender: содержимое видно мгновенно; формы защищены submit-блокировщиком в App.razor *@
@rendermode InteractiveServer
@using ExamForge.Application.TeacherFlow
@using ExamForge.Infrastructure.Identity
@using ExamForge.Infrastructure.Persistence
@using ExamForge.Infrastructure.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject DictionaryService DictionaryService
@inject ExamForgeDbContext Db
@inject UserManager<TeacherUser> UserManager
@inject AuthenticationStateProvider AuthState

<PageTitle>Словарь — Exam Forge</PageTitle>

<h1>Словарь</h1>
<p class="ef-card__meta">
    Словарь — источник записей для автогенерации черновиков вопросов (выбор перевода) и справочник терминов.
    Записи подтверждает преподаватель; неподтверждённые записи в тесты не попадают.
</p>

<section class="ef-card" aria-labelledby="new-dict-title">
    <h2 id="new-dict-title" class="ef-card__title">Новый словарь</h2>
    @if (_subjects.Count == 0)
    {
        <div class="ef-callout ef-callout--warning">
            <p>Сначала создайте предмет: раздел «Настройки» → блок «Предметы». Затем вернитесь сюда.</p>
        </div>
    }
    else
    {
        <EditForm Model="CreateForm" OnValidSubmit="CreateAsync" class="ef-form">
            <DataAnnotationsValidator />
            <div class="ef-form ef-form--inline">
                <div class="ef-field">
                    <label for="d-name">Название</label>
                    <InputText id="d-name" @bind-Value="CreateForm.Name" autocomplete="off" placeholder="Латинско-русский словарь" />
                    <ValidationMessage For="() => CreateForm.Name" />
                </div>
                <div class="ef-field">
                    <label for="d-subject">Предмет</label>
                    <select id="d-subject" @bind="CreateForm.SubjectId">
                        @foreach (var s in _subjects)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <button class="ef-button ef-button--primary" type="submit">Создать</button>
            </div>
        </EditForm>
    }
</section>

@foreach (var dict in _dictionaries)
{
    <section class="ef-card" aria-labelledby="dict-@dict.DictionaryId">
        @if (_editDictionaryId == dict.DictionaryId)
        {
            <div class="ef-form ef-form--inline">
                <div class="ef-field">
                    <label for="@($"dict-edit-{dict.DictionaryId}")">Название словаря</label>
                    <InputText id="@($"dict-edit-{dict.DictionaryId}")" @bind-Value="_editDictionaryName" autocomplete="off" />
                </div>
                <button class="ef-button ef-button--sm ef-button--primary" @onclick="() => RenameDictionaryAsync(dict.DictionaryId)">Сохранить</button>
                <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => _editDictionaryId = null">Отмена</button>
            </div>
        }
        else
        {
            <h3 id="dict-@dict.DictionaryId" class="ef-card__title">@dict.Name</h3>
        }
        <p class="ef-card__meta">Записей: @dict.Entries</p>

        <div class="ef-actions">
            <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => StartDictionaryEdit(dict.DictionaryId, dict.Name)">Переименовать</button>
            @if (_confirmDeleteDictionaryId == dict.DictionaryId)
            {
                <button class="ef-button ef-button--sm ef-button--danger" @onclick="() => DeleteDictionaryAsync(dict.DictionaryId)">
                    Точно удалить словарь с @dict.Entries записями?
                </button>
                <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => _confirmDeleteDictionaryId = null">Отмена</button>
            }
            else
            {
                <button class="ef-button ef-button--sm ef-button--danger" @onclick="() => _confirmDeleteDictionaryId = dict.DictionaryId">Удалить словарь</button>
            }
        </div>

        <div class="ef-actions">
            <InputFile OnChange="e => ImportFileSelected(e)" accept=".pdf,application/pdf" />
            <button type="button" class="ef-button ef-button--sm ef-button--secondary"
                    @onclick="() => ImportAsync(dict.DictionaryId)" disabled="@(_importFile is null || _busy)">
                Импортировать PDF
            </button>
            @if (_importResult is not null)
            {
                <span class="ef-card__meta">@_importResult</span>
            }
        </div>

        <details>
            <summary class="ef-card__meta">Добавить запись вручную</summary>
            <EditForm Model="EntryForm" OnValidSubmit="() => AddEntryAsync(dict.DictionaryId)" class="ef-form">
                <DataAnnotationsValidator />
                <div class="ef-form ef-form--inline">
                    <div class="ef-field">
                        <label for="@($"me-lemma-{dict.DictionaryId}")">Лемма</label>
                        <InputText id="@($"me-lemma-{dict.DictionaryId}")" @bind-Value="EntryForm.Lemma" autocomplete="off" placeholder="oculus" />
                    </div>
                    <div class="ef-field">
                        <label for="@($"me-tr-{dict.DictionaryId}")">Перевод</label>
                        <InputText id="@($"me-tr-{dict.DictionaryId}")" @bind-Value="EntryForm.Translation" autocomplete="off" placeholder="глаз" />
                    </div>
                    <div class="ef-field">
                        <label for="@($"me-form-{dict.DictionaryId}")">Форма</label>
                        <select id="@($"me-form-{dict.DictionaryId}")" @bind="EntryForm.FormKind">
                            <option value="">—</option>
                            <option value="liquid">liquid</option>
                            <option value="solid">solid</option>
                        </select>
                    </div>
                    <div class="ef-field">
                        <label for="@($"me-gender-{dict.DictionaryId}")">Род</label>
                        <select id="@($"me-gender-{dict.DictionaryId}")" @bind="EntryForm.Gender">
                            <option value="">—</option>
                            <option value="m">m</option>
                            <option value="f">f</option>
                            <option value="n">n</option>
                        </select>
                    </div>
                    <div class="ef-field">
                        <label for="@($"me-decl-{dict.DictionaryId}")">Склонение</label>
                        <select id="@($"me-decl-{dict.DictionaryId}")" @bind="EntryForm.Declension">
                            <option value="">—</option>
                            <option>I</option>
                            <option>II</option>
                            <option>III</option>
                            <option>IV</option>
                            <option>V</option>
                        </select>
                    </div>
                    <button class="ef-button ef-button--sm ef-button--secondary" type="submit" disabled="@_busy">Добавить</button>
                </div>
            </EditForm>
            <p class="ef-card__meta">Ручной ввод — сразу подтверждённая запись (источник: преподаватель). Признаки известного списка, новых значений система не выдумывает.</p>
        </details>

        @if (_entries.TryGetValue(dict.DictionaryId, out var entries) && entries.Count > 0)
        {
            <table class="ef-table">
                <caption>Записи словаря</caption>
                <thead>
                    <tr>
                        <th scope="col">Лемма</th>
                        <th scope="col">Перевод</th>
                        <th scope="col">Статус</th>
                        <th scope="col">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in entries)
                    {
                        <tr>
                            <td>@entry.Lemma</td>
                            <td>@(entry.Translations.Count > 0 ? entry.Translations[0] : "—")</td>
                            <td>
                                @if (entry.Status == "Confirmed")
                                {
                                    <span class="ef-badge">подтверждена</span>
                                }
                                else if (entry.Status == "Rejected")
                                {
                                    <span class="ef-badge">отклонена</span>
                                }
                                else
                                {
                                    <span class="ef-badge ef-badge--warning">на проверке</span>
                                }
                            </td>
                            <td>
                                @if (entry.Status == "ImportedDraft")
                                {
                                    <button class="ef-button ef-button--sm ef-button--primary"
                                            @onclick="() => ConfirmAsync(dict.DictionaryId, entry)">Подтвердить</button>
                                    <button class="ef-button ef-button--sm ef-button--quiet"
                                            @onclick="() => RejectAsync(dict.DictionaryId, entry.EntryId)">Отклонить</button>
                                }
                                @if (entry.Status == "Confirmed")
                                {
                                    <button class="ef-button ef-button--sm ef-button--secondary"
                                            @onclick="() => DraftQuestionAsync(dict.DictionaryId, entry.EntryId)">
                                        Черновик вопроса
                                    </button>
                                }
                                @if (_confirmDeleteEntryId == entry.EntryId)
                                {
                                    <button class="ef-button ef-button--sm ef-button--danger"
                                            @onclick="() => DeleteEntryAsync(dict.DictionaryId, entry.EntryId)">Точно удалить?</button>
                                    <button class="ef-button ef-button--sm ef-button--quiet"
                                            @onclick="() => _confirmDeleteEntryId = null">Отмена</button>
                                }
                                else
                                {
                                    <button class="ef-button ef-button--sm ef-button--danger"
                                            @onclick="() => _confirmDeleteEntryId = entry.EntryId">Удалить</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (entries is not null)
        {
            <p class="ef-card__meta">Записей нет: импортируйте PDF или добавьте вручную выше.</p>
        }
        else
        {
            <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => ToggleEntriesAsync(dict.DictionaryId)">Показать записи</button>
        }
    </section>
}

@if (_error is not null)
{
    <p class="ef-form-error" role="alert">@_error</p>
}

@code {
    private sealed class CreateDictForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Введите название.")]
        public string Name { get; set; } = string.Empty;
        public Guid? SubjectId { get; set; }
    }

    private sealed class ManualEntryForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Введите лемму.")]
        public string Lemma { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Введите перевод.")]
        public string Translation { get; set; } = string.Empty;
        public string? FormKind { get; set; }
        public string? Gender { get; set; }
        public string? Declension { get; set; }
    }

    private readonly List<(Guid Id, string Name)> _subjects = [];
    private readonly List<DictionaryDto> _dictionaries = [];
    private readonly Dictionary<Guid, List<DictionaryEntryDto>> _entries = [];
    private CreateDictForm CreateForm { get; set; } = new();
    private ManualEntryForm EntryForm { get; set; } = new();
    private IBrowserFile? _importFile;
    private string? _importResult;
    private string? _error;
    private bool _busy;
    private Guid? _editDictionaryId;
    private string _editDictionaryName = string.Empty;
    private Guid? _confirmDeleteDictionaryId;
    private Guid? _confirmDeleteEntryId;

    private void StartDictionaryEdit(Guid dictionaryId, string name)
    {
        _editDictionaryId = dictionaryId;
        _editDictionaryName = name;
        _confirmDeleteDictionaryId = null;
        _error = null;
    }

    private async Task RenameDictionaryAsync(Guid dictionaryId)
    {
        _error = null;
        try
        {
            await DictionaryService.RenameAsync(await ActorAsync(), dictionaryId, _editDictionaryName.Trim(), CancellationToken.None);
            _editDictionaryId = null;
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DeleteDictionaryAsync(Guid dictionaryId)
    {
        _error = null;
        try
        {
            await DictionaryService.DeleteAsync(await ActorAsync(), dictionaryId, CancellationToken.None);
            _confirmDeleteDictionaryId = null;
            _entries.Remove(dictionaryId);
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; _confirmDeleteDictionaryId = null; }
    }

    private async Task DeleteEntryAsync(Guid dictionaryId, Guid entryId)
    {
        _error = null;
        try
        {
            await DictionaryService.DeleteEntryAsync(await ActorAsync(), entryId, CancellationToken.None);
            _confirmDeleteEntryId = null;
            _entries[dictionaryId] = [.. await DictionaryService.EntriesAsync(dictionaryId, CancellationToken.None)];
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; _confirmDeleteEntryId = null; }
    }

    private async Task AddEntryAsync(Guid dictionaryId)
    {
        _busy = true;
        _error = null;
        try
        {
            await DictionaryService.AddEntryManuallyAsync(await ActorAsync(), dictionaryId,
                EntryForm.Lemma, EntryForm.Translation,
                NullIfEmpty(EntryForm.FormKind), NullIfEmpty(EntryForm.Gender), NullIfEmpty(EntryForm.Declension),
                CancellationToken.None);
            EntryForm = new ManualEntryForm();
            _entries[dictionaryId] = [.. await DictionaryService.EntriesAsync(dictionaryId, CancellationToken.None)];
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _subjects.Clear();
        _subjects.AddRange((await Db.Subjects.AsNoTracking().OrderBy(s => s.Name).ToListAsync())
            .Select(s => (s.Id, s.Name)));
        CreateForm.SubjectId ??= _subjects.FirstOrDefault().Id;
        _dictionaries.Clear();
        _dictionaries.AddRange(await DictionaryService.ListAsync(CancellationToken.None));
    }

    private void ImportFileSelected(InputFileChangeEventArgs e) => _importFile = e.File;

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            if (CreateForm.SubjectId is { } subjectId)
            {
                await DictionaryService.CreateAsync(await ActorAsync(), subjectId, CreateForm.Name, CancellationToken.None);
                CreateForm = new CreateDictForm { SubjectId = subjectId };
                await ReloadAsync();
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ImportAsync(Guid dictionaryId)
    {
        if (_importFile is null)
            return;
        _busy = true;
        _error = null;
        _importResult = null;
        try
        {
            await using var stream = _importFile.OpenReadStream(30 * 1024 * 1024);
            var (imported, skipped) = await DictionaryService.ImportPdfAsync(
                await ActorAsync(), dictionaryId, stream, CancellationToken.None);
            _importResult = $"Импортировано {imported} черновиков, пропущено строк: {skipped}. Всё — на проверку.";
            _importFile = null;
            _entries[dictionaryId] = [.. await DictionaryService.EntriesAsync(dictionaryId, CancellationToken.None)];
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ToggleEntriesAsync(Guid dictionaryId)
        => _entries[dictionaryId] = [.. await DictionaryService.EntriesAsync(dictionaryId, CancellationToken.None)];

    private async Task ConfirmAsync(Guid dictionaryId, DictionaryEntryDto entry)
    {
        _error = null;
        try
        {
            // Признаки подтверждает преподаватель; здесь — базовое подтверждение без признаков
            // (детальная форма признаков — форма страницы; пустые признаки => NeedsReview снимается при явном подтверждении).
            await DictionaryService.ConfirmAsync(await ActorAsync(), entry.EntryId,
                null, null, null, null, entry.Translations, CancellationToken.None);
            _entries[dictionaryId] = [.. await DictionaryService.EntriesAsync(dictionaryId, CancellationToken.None)];
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task RejectAsync(Guid dictionaryId, Guid entryId)
    {
        await DictionaryService.RejectAsync(await ActorAsync(), entryId, CancellationToken.None);
        _entries[dictionaryId] = [.. await DictionaryService.EntriesAsync(dictionaryId, CancellationToken.None)];
    }

    private async Task DraftQuestionAsync(Guid dictionaryId, Guid entryId)
    {
        _error = null;
        try
        {
            var result = await DictionaryService.CreateDraftQuestionAsync(await ActorAsync(), entryId, CancellationToken.None);
            _importResult = $"Создан черновик вопроса (Bank ID {result}). Опубликуйте его в «Банке заданий».";
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task<TeacherActor> ActorAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(state.User)
            ?? throw new InvalidOperationException("Нет пользователя.");
        return new TeacherActor(user.Id, await UserManager.IsInRoleAsync(user, AppRoles.Administrator));
    }
}
