@page "/cabinet/groups"
@layout Layout.TeacherLayout
@attribute [Authorize]
@* prerender: содержимое видно мгновенно; формы защищены submit-блокировщиком в App.razor *@
@rendermode InteractiveServer
@using ExamForge.Application.TeacherFlow
@using ExamForge.Infrastructure.Identity
@using ExamForge.Infrastructure.Services
@using Microsoft.AspNetCore.Identity
@inject GroupService GroupService
@inject UserManager<TeacherUser> UserManager
@inject AuthenticationStateProvider AuthState

<PageTitle>Группы — Exam Forge</PageTitle>

<h1>Группы</h1>
<p class="ef-card__meta">Составы и доступ преподавателей. ФИО не уникальный ключ: однофамильцы не объединяются. Удаляется только пустая группа; профиль студента с историей попыток не удаляется.</p>

<section class="ef-card" aria-labelledby="create-group-title">
    <h2 id="create-group-title" class="ef-card__title">Новая группа</h2>
    <EditForm Model="CreateForm" OnValidSubmit="CreateGroupAsync" class="ef-form">
        <DataAnnotationsValidator />
        <div class="ef-field">
            <label for="g-name">Название</label>
            <InputText id="g-name" @bind-Value="CreateForm.Name" autocomplete="off" placeholder="ЛД-201" />
            <ValidationMessage For="() => CreateForm.Name" />
        </div>
        <button class="ef-button ef-button--primary" type="submit" disabled="@_busy">Создать</button>
    </EditForm>
</section>

@if (_error is not null)
{
    <p class="ef-form-error" role="alert">@_error</p>
}
@if (_oneTimePassword is not null)
{
    <div class="ef-callout ef-callout--warning" role="alert">
        <p>Новый одноразовый пароль: <strong>@_oneTimePassword</strong>. Показывается только сейчас — запишите и передайте студенту лично.</p>
    </div>
}

@if (_groups.Count == 0)
{
    <div class="ef-callout ef-callout--info"><p>Групп пока нет.</p></div>
}
@foreach (var group in _groups)
{
    <section class="ef-card" aria-labelledby="grp-@group.GroupId">
        @if (_editGroupId == group.GroupId)
        {
            <div class="ef-form ef-form--inline">
                <div class="ef-field">
                    <label for="@($"grp-edit-{group.GroupId}")">Название группы</label>
                    <InputText id="@($"grp-edit-{group.GroupId}")" @bind-Value="_editGroupName" autocomplete="off" />
                </div>
                <button class="ef-button ef-button--sm ef-button--primary" @onclick="() => RenameGroupAsync(group.GroupId)">Сохранить</button>
                <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => _editGroupId = null">Отмена</button>
            </div>
        }
        else
        {
            <h3 id="grp-@group.GroupId" class="ef-card__title">@group.Name</h3>
        }
        <p class="ef-card__meta">Студентов: @group.StudentCount</p>

        <div class="ef-actions">
            <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => StartGroupEdit(group.GroupId, group.Name)">Переименовать</button>
            @if (_confirmDeleteGroupId == group.GroupId)
            {
                <button class="ef-button ef-button--sm ef-button--danger" @onclick="() => DeleteGroupAsync(group.GroupId)">Точно удалить группу?</button>
                <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => _confirmDeleteGroupId = null">Отмена</button>
            }
            else
            {
                <button class="ef-button ef-button--sm ef-button--danger" @onclick="() => _confirmDeleteGroupId = group.GroupId">Удалить группу</button>
            }
            <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => ToggleMembersAsync(group.GroupId)">
                @(_members.ContainsKey(group.GroupId) ? "Скрыть состав" : "Показать состав")
            </button>
        </div>

        <EditForm Model="NewStudentForm" OnValidSubmit="() => AddStudentAsync(group.GroupId)" class="ef-form">
            <DataAnnotationsValidator />
            <div class="ef-form ef-form--inline">
                <div class="ef-field">
                    <label for="@($"ns-last-{group.GroupId}")">Фамилия</label>
                    <InputText id="@($"ns-last-{group.GroupId}")" @bind-Value="NewStudentForm.LastName" autocomplete="off" />
                    <ValidationMessage For="() => NewStudentForm.LastName" />
                </div>
                <div class="ef-field">
                    <label for="@($"ns-first-{group.GroupId}")">Имя</label>
                    <InputText id="@($"ns-first-{group.GroupId}")" @bind-Value="NewStudentForm.FirstName" autocomplete="off" />
                    <ValidationMessage For="() => NewStudentForm.FirstName" />
                </div>
                <div class="ef-field">
                    <label for="@($"ns-middle-{group.GroupId}")">Отчество (если есть)</label>
                    <InputText id="@($"ns-middle-{group.GroupId}")" @bind-Value="NewStudentForm.MiddleName" autocomplete="off" />
                </div>
                <button class="ef-button ef-button--sm ef-button--secondary" type="submit">+ студент</button>
            </div>
        </EditForm>

        @if (_members.TryGetValue(group.GroupId, out var members) && members.Count > 0)
        {
            <table class="ef-table">
                <caption>Состав @group.Name</caption>
                <thead><tr><th scope="col">Студент</th><th scope="col">В группе с</th><th scope="col">Аккаунт</th><th scope="col">Действия</th></tr></thead>
                <tbody>
                    @foreach (var member in members)
                    {
                        var account = _accounts.GetValueOrDefault(member.StudentProfileId);
                        @if (_editStudentId == member.StudentProfileId)
                        {
                            <tr>
                                <td>
                                    <div class="ef-form ef-form--inline">
                                        <InputText @bind-Value="_editStudentLastName" aria-label="Фамилия" autocomplete="off" />
                                        <InputText @bind-Value="_editStudentFirstName" aria-label="Имя" autocomplete="off" />
                                        <InputText @bind-Value="_editStudentMiddleName" aria-label="Отчество" autocomplete="off" />
                                    </div>
                                </td>
                                <td>@member.JoinedAtUtc.LocalDateTime.ToString("dd.MM.yyyy")</td>
                                <td>@(account?.Login ?? "—")</td>
                                <td>
                                    <div class="ef-actions">
                                        <button class="ef-button ef-button--sm ef-button--primary" @onclick="() => SaveStudentAsync(member.StudentProfileId, group.GroupId)">Сохранить</button>
                                        <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => _editStudentId = null">Отмена</button>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>@member.Name</td>
                                <td>@member.JoinedAtUtc.LocalDateTime.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @if (account is null)
                                    {
                                        <span class="ef-card__meta">нет</span>
                                    }
                                    else
                                    {
                                        <span>@account.Login</span>
                                        if (account.IsDisabled)
                                        {
                                            <span class="ef-badge ef-badge--warning">выключен</span>
                                        }
                                    }
                                </td>
                                <td>
                                    <div class="ef-actions">
                                        <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => StartStudentEdit(member)">ФИО</button>
                                        <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => DetachAsync(group.GroupId, member.StudentProfileId)">Убрать из группы</button>
                                        @if (account is not null)
                                        {
                                            <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => ResetAccountPasswordAsync(account.Id)">Сбросить пароль</button>
                                            @if (account.IsDisabled)
                                            {
                                                <button class="ef-button ef-button--sm ef-button--secondary" @onclick="() => SetAccountActiveAsync(account.Id, true, group.GroupId)">Включить</button>
                                            }
                                            else
                                            {
                                                <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => SetAccountActiveAsync(account.Id, false, group.GroupId)">Выключить</button>
                                            }
                                            @if (_confirmDeleteAccountId == account.Id)
                                            {
                                                <button class="ef-button ef-button--sm ef-button--danger" @onclick="() => DeleteAccountAsync(account.Id, group.GroupId)">Точно удалить аккаунт?</button>
                                                <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => _confirmDeleteAccountId = null">Отмена</button>
                                            }
                                            else
                                            {
                                                <button class="ef-button ef-button--sm ef-button--danger" @onclick="() => _confirmDeleteAccountId = account.Id">Удалить аккаунт</button>
                                            }
                                        }
                                        @if (_confirmDeleteStudentId == member.StudentProfileId)
                                        {
                                            <button class="ef-button ef-button--sm ef-button--danger" @onclick="() => DeleteStudentAsync(member.StudentProfileId)">Точно удалить профиль?</button>
                                            <button class="ef-button ef-button--sm ef-button--quiet" @onclick="() => _confirmDeleteStudentId = null">Отмена</button>
                                        }
                                        else
                                        {
                                            <button class="ef-button ef-button--sm ef-button--danger" @onclick="() => _confirmDeleteStudentId = member.StudentProfileId">Удалить</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
        else if (members is not null)
        {
            <p class="ef-card__meta">Состав пуст.</p>
        }
    </section>
}

@code {
    private sealed class CreateFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Введите название группы.")]
        public string Name { get; set; } = string.Empty;
    }

    private sealed class StudentFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Введите фамилию.")]
        public string LastName { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Введите имя.")]
        public string FirstName { get; set; } = string.Empty;
        public string? MiddleName { get; set; }
    }

    private readonly List<GroupDto> _groups = [];
    private readonly Dictionary<Guid, List<GroupStudentDto>> _members = [];
    private readonly Dictionary<Guid, ExamForge.Domain.People.StudentAccount?> _accounts = [];
    private CreateFormModel CreateForm { get; set; } = new();
    private StudentFormModel NewStudentForm { get; set; } = new();
    private string? _error;
    private string? _oneTimePassword;
    private bool _busy;

    private Guid? _editGroupId;
    private string _editGroupName = string.Empty;
    private Guid? _confirmDeleteGroupId;

    private Guid? _editStudentId;
    private string _editStudentLastName = string.Empty;
    private string _editStudentFirstName = string.Empty;
    private string? _editStudentMiddleName;
    private Guid? _confirmDeleteStudentId;

    private Guid? _confirmDeleteAccountId;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _groups.Clear();
        _groups.AddRange(await GroupService.ListAsync(await ActorAsync(), CancellationToken.None));
    }

    private async Task CreateGroupAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await GroupService.CreateAsync(await ActorAsync(), CreateForm.Name, CancellationToken.None);
            CreateForm = new CreateFormModel();
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void StartGroupEdit(Guid groupId, string name)
    {
        _editGroupId = groupId;
        _editGroupName = name;
        _confirmDeleteGroupId = null;
        _error = null;
    }

    private async Task RenameGroupAsync(Guid groupId)
    {
        _error = null;
        try
        {
            await GroupService.RenameAsync(await ActorAsync(), groupId, _editGroupName.Trim(), CancellationToken.None);
            _editGroupId = null;
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DeleteGroupAsync(Guid groupId)
    {
        _error = null;
        try
        {
            await GroupService.DeleteAsync(await ActorAsync(), groupId, CancellationToken.None);
            _confirmDeleteGroupId = null;
            _members.Remove(groupId);
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; _confirmDeleteGroupId = null; }
    }

    private async Task ToggleMembersAsync(Guid groupId)
    {
        if (_members.Remove(groupId))
            return;
        var actor = await ActorAsync();
        _members[groupId] = [.. await GroupService.MembersAsync(actor, groupId, CancellationToken.None)];
        _accounts.Clear();
        foreach (var m in _members[groupId])
            _accounts[m.StudentProfileId] = await GroupService.AccountOfStudentAsync(actor, m.StudentProfileId, CancellationToken.None);
    }

    private async Task AddStudentAsync(Guid groupId)
    {
        _busy = true;
        _error = null;
        try
        {
            await GroupService.AddNewStudentAsync(await ActorAsync(), groupId,
                NewStudentForm.LastName, NewStudentForm.FirstName, NewStudentForm.MiddleName, CancellationToken.None);
            NewStudentForm = new StudentFormModel();
            _members[groupId] = [.. await GroupService.MembersAsync(await ActorAsync(), groupId, CancellationToken.None)];
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void StartStudentEdit(GroupStudentDto member)
    {
        _editStudentId = member.StudentProfileId;
        _editStudentLastName = member.LastName;
        _editStudentFirstName = member.FirstName;
        _editStudentMiddleName = member.MiddleName;
        _confirmDeleteStudentId = null;
        _error = null;
    }

    private async Task SaveStudentAsync(Guid studentProfileId, Guid groupId)
    {
        _error = null;
        try
        {
            await GroupService.RenameStudentAsync(await ActorAsync(), studentProfileId,
                _editStudentLastName, _editStudentFirstName, _editStudentMiddleName, CancellationToken.None);
            _editStudentId = null;
            _members[groupId] = [.. await GroupService.MembersAsync(await ActorAsync(), groupId, CancellationToken.None)];
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DetachAsync(Guid groupId, Guid studentProfileId)
    {
        _error = null;
        try
        {
            await GroupService.RemoveStudentAsync(await ActorAsync(), groupId, studentProfileId, CancellationToken.None);
            _members[groupId] = [.. await GroupService.MembersAsync(await ActorAsync(), groupId, CancellationToken.None)];
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DeleteStudentAsync(Guid studentProfileId)
    {
        _error = null;
        try
        {
            await GroupService.DeleteStudentAsync(await ActorAsync(), studentProfileId, CancellationToken.None);
            _confirmDeleteStudentId = null;
            foreach (var groupId in _members.Keys.ToList())
                _members[groupId] = [.. await GroupService.MembersAsync(await ActorAsync(), groupId, CancellationToken.None)];
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; _confirmDeleteStudentId = null; }
    }

    private async Task ResetAccountPasswordAsync(Guid accountId)
    {
        _error = null;
        _oneTimePassword = null;
        try
        {
            _oneTimePassword = await GroupService.ResetStudentAccountPasswordAsync(await ActorAsync(), accountId, CancellationToken.None);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SetAccountActiveAsync(Guid accountId, bool active, Guid groupId)
    {
        _error = null;
        try
        {
            await GroupService.SetStudentAccountActiveAsync(await ActorAsync(), accountId, active, CancellationToken.None);
            var actor = await ActorAsync();
            _accounts.Clear();
            foreach (var m in _members[groupId])
                _accounts[m.StudentProfileId] = await GroupService.AccountOfStudentAsync(actor, m.StudentProfileId, CancellationToken.None);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DeleteAccountAsync(Guid accountId, Guid groupId)
    {
        _error = null;
        try
        {
            await GroupService.DeleteStudentAccountAsync(await ActorAsync(), accountId, CancellationToken.None);
            _confirmDeleteAccountId = null;
            var actor = await ActorAsync();
            _accounts.Clear();
            foreach (var m in _members[groupId])
                _accounts[m.StudentProfileId] = await GroupService.AccountOfStudentAsync(actor, m.StudentProfileId, CancellationToken.None);
        }
        catch (Exception ex) { _error = ex.Message; _confirmDeleteAccountId = null; }
    }

    private async Task<TeacherActor> ActorAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(state.User)
            ?? throw new InvalidOperationException("Нет пользователя.");
        return new TeacherActor(user.Id, await UserManager.IsInRoleAsync(user, AppRoles.Administrator));
    }
}
