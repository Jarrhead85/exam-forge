@page "/cabinet"
@layout Layout.TeacherLayout
@attribute [Authorize]
@* prerender: контент обзора виден мгновенно из SSR-ответа, ещё до подключения circuit
   (страница без форм — статической отправки быть не может). *@
@rendermode InteractiveServer
@using ExamForge.Application.TeacherFlow
@using ExamForge.Infrastructure.Identity
@using ExamForge.Infrastructure.Services
@using Microsoft.AspNetCore.Identity
@inject TeacherAssignmentsService AssignmentsService
@inject ManualReviewService Reviews
@inject UserManager<TeacherUser> UserManager
@inject AuthenticationStateProvider AuthState
@inject TimeProvider Clock

<PageTitle>Обзор — Exam Forge</PageTitle>

<div class="ef-page-heading">
    <h1>Обзор</h1>
    <a class="ef-button ef-button--primary" href="cabinet/assignments">Создать работу</a>
</div>

<div class="ef-portal-grid ef-dashboard">
    <section class="ef-card" aria-labelledby="today-title">
        <h2 id="today-title" class="ef-card__title">Начинаются сегодня</h2>
        @AssignmentList(_today, "На сегодня новых работ нет.")
    </section>

    <section class="ef-card" aria-labelledby="active-title">
        <h2 id="active-title" class="ef-card__title">Доступны студентам</h2>
        @AssignmentList(_active, "Сейчас нет открытых работ.")
    </section>
</div>

<section class="ef-card" aria-labelledby="dash-review">
    <h2 id="dash-review" class="ef-card__title">Ждут проверки</h2>
    @if (_pendingReview.Count == 0)
    {
        <p>Новых работ на проверку нет.</p>
    }
    else
    {
        <ul class="ef-dashboard-list">
            @foreach (var attempt in _pendingReview)
            {
                <li>
                    <a href="@($"cabinet/reviews/{attempt.AttemptId}")">@attempt.StudentName — попытка @attempt.AttemptNumber</a>
                    <span class="ef-card__meta">Критериев на проверку: @attempt.PendingCriteria</span>
                </li>
            }
        </ul>
        <a href="cabinet/reviews">Открыть очередь проверки</a>
    }
</section>

@if (_today.Count == 0 && _active.Count == 0 && _pendingReview.Count == 0)
{
    <section class="ef-card" aria-labelledby="first-work-title">
        <h2 id="first-work-title" class="ef-card__title">Подготовьте первую работу</h2>
        <p>Добавьте задания в банк, соберите и опубликуйте тест, затем выдайте коды группе.</p>
        <div class="ef-actions">
            <a class="ef-button ef-button--secondary" href="cabinet/questions">Открыть банк заданий</a>
            <a href="demo/teacher">Посмотреть пример</a>
        </div>
    </section>
}

@code {
    private IReadOnlyList<TeacherAssignmentDto> _today = [];
    private IReadOnlyList<TeacherAssignmentDto> _active = [];
    private IReadOnlyList<ReviewQueueItemDto> _pendingReview = [];

    protected override async Task OnInitializedAsync()
    {
        var actor = await ActorAsync();
        var today = Clock.GetLocalNow().Date;
        var start = TimeZoneInfo.ConvertTimeToUtc(today, Clock.LocalTimeZone);
        var end = TimeZoneInfo.ConvertTimeToUtc(today.AddDays(1), Clock.LocalTimeZone);
        _today = await AssignmentsService.DashboardAssignmentsAsync(actor, start, end, CancellationToken.None);
        _active = await AssignmentsService.DashboardAssignmentsAsync(actor, null, null, CancellationToken.None);
        var pending = await Reviews.GetOpenQueueAsync(actor, null, CancellationToken.None);
        _pendingReview = [.. pending.Select(item => item.Item)];
    }

    private RenderFragment AssignmentList(IReadOnlyList<TeacherAssignmentDto> assignments, string empty) => @<text>
        @if (assignments.Count == 0)
        {
            <p>@empty</p>
        }
        else
        {
            <ul class="ef-dashboard-list">
                @foreach (var assignment in assignments)
                {
                    <li>
                        <a href="@($"cabinet/assignments/{assignment.AssignmentId}")">@assignment.TestTitle</a>
                        <span class="ef-card__meta">Приглашено @assignment.StudentsInvited · Попыток @assignment.AttemptsStarted</span>
                    </li>
                }
            </ul>
        }
    </text>;

    private async Task<TeacherActor> ActorAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(state.User)
            ?? throw new InvalidOperationException("Нет пользователя.");
        return new TeacherActor(user.Id, await UserManager.IsInRoleAsync(user, AppRoles.Administrator));
    }
}
