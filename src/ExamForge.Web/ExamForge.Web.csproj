<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Канонический паттерн SSR-форм: [SupplyParameterFromForm] + инициализатор (как в шаблонах Microsoft). -->
    <NoWarn>$(NoWarn);BL0008</NoWarn>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- ReadyToRun только при сборке под linux (docker-образ): холодный старт на слабом VDS
       без 20 с JIT. На Windows-сборках не включается; WASM-клиент не затрагивается
       (свойства из csproj не протекают через ProjectReference, в отличие от CLI -p:). -->
  <PropertyGroup Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExamForge.Application\ExamForge.Application.csproj" />
    <ProjectReference Include="..\ExamForge.Infrastructure\ExamForge.Infrastructure.csproj" />
    <ProjectReference Include="..\ExamForge.Web.Client\ExamForge.Web.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
